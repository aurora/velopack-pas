<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="velopack_pas"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="Harald Lapp"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <IncludeFiles Value="../../src"/>
        <OtherUnitFiles Value="../../src;.."/>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="Velopack installer and auto-update bindings for Free Pascal / Lazarus"/>
    <License Value="MIT"/>
    <Version Minor="1"/>
    <Files Count="9">
      <Item1>
        <Filename Value="../../src/Velopack.App.pas"/>
        <UnitName Value="Velopack.App"/>
      </Item1>
      <Item2>
        <Filename Value="../../src/Velopack.Internal.pas"/>
        <UnitName Value="Velopack.Internal"/>
      </Item2>
      <Item3>
        <Filename Value="../../src/Velopack.Log.pas"/>
        <UnitName Value="Velopack.Log"/>
      </Item3>
      <Item4>
        <Filename Value="../../src/Velopack.Manager.pas"/>
        <UnitName Value="Velopack.Manager"/>
      </Item4>
      <Item5>
        <Filename Value="../../src/Velopack.Native.pas"/>
        <UnitName Value="Velopack.Native"/>
      </Item5>
      <Item6>
        <Filename Value="../../src/Velopack.Strings.pas"/>
        <UnitName Value="Velopack.Strings"/>
      </Item6>
      <Item7>
        <Filename Value="../../src/Velopack.Types.pas"/>
        <UnitName Value="Velopack.Types"/>
      </Item7>
      <Item8>
        <Filename Value="../../src/Velopack.Updater.pas"/>
        <UnitName Value="Velopack.Updater"/>
      </Item8>
      <Item9>
        <Filename Value="../Velopack.Reg.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="Velopack.Reg"/>
      </Item9>
    </Files>
    <RequiredPkgs Count="1">
      <Item1>
        <PackageName Value="FCL"/>
      </Item1>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
